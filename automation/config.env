# Sixty Sessions — daily runner configuration.
# Plain KEY=value. No shell expansion, no quotes needed.

# --- what to run -------------------------------------------------------
REPO_DIR=/home/alberto/Documentos/Personal/Financial_manager
ROADMAP_FILE=ROADMAP.md

# Time the timer fires, local time (Europe/Madrid). Used by install.sh.
RUN_TIME=19:30

# --- how the agent runs ------------------------------------------------
# The whole agent lives behind this one line. Placeholders are filled in
# after the command is split into words, so {prompt} always arrives as a
# single argument no matter what is inside it:
#
#   {prompt}  the day's instructions   {tools}   ALLOWED_TOOLS
#   {model}   MODEL                    {denied}  DENIED_TOOLS
#   {repo}    REPO_DIR
#
# Leave {prompt} out entirely and the prompt is piped to the agent's stdin
# instead. Output is read as JSON if it parses, otherwise as plain text, so
# a non-JSON agent needs no code change - only a different line here.
#
# Swapping Claude Code out is a one-line edit. Sketches to adapt:
#   AGENT_CMD=gemini --yolo -p {prompt}
#   AGENT_CMD=aider --message {prompt} --yes --no-auto-commits
#   AGENT_CMD=codex exec {prompt}
# Check the flags against the tool's own --help before trusting a run; these
# CLIs change their interfaces often. Whatever you pick must be an *agentic*
# CLI that edits files and runs commands on its own - a chat model cannot do
# this job.
AGENT_CMD=claude -p {prompt} --output-format json --model {model} --permission-mode acceptEdits --permission-prompts none --allowedTools {tools} --disallowedTools {denied}

MODEL=opus
# Hard wall-clock limit for one step, in seconds. The step is abandoned
# after this and the day is marked failed rather than left half-done.
STEP_TIMEOUT=3600
# Anything not in this list is DENIED automatically instead of prompting,
# so an unattended run can never hang waiting for input.
ALLOWED_TOOLS=Read,Write,Edit,Glob,Grep,NotebookEdit,TodoWrite,WebFetch,WebSearch,Bash
# The runner owns version control, so the agent is never allowed to touch it.
# Claude Code syntax. Another agent will want its own - or none, in which case
# only the prompt's "Hard rules" and verify()'s PROTECTED check hold the line.
DENIED_TOOLS=Bash(git commit:*),Bash(git push:*),Bash(git checkout:*),Bash(git reset:*),Bash(git rebase:*)

# --- git ---------------------------------------------------------------
BASE_BRANCH=main
# branch = one branch per day, pushed for review (default, reversible)
# main   = commit straight onto BASE_BRANCH (no review gate)
BRANCH_MODE=branch
PUSH=1
# With BRANCH_MODE=branch: merge the day's branch into BASE_BRANCH as soon as
# the step verifies, then push BASE_BRANCH. The day branch never reaches
# GitHub, so there is no pull request to accept. A day that FAILS is never
# merged - its partial work stays on its own branch for you to look at.
AUTO_MERGE=1
# Requires a working `gh auth status`. Pointless while AUTO_MERGE=1, since
# there is no remote branch left to open a PR from.
OPEN_PR=0

# --- reporting ---------------------------------------------------------
NOTIFY=1
# Optional: tick the day off in the Sixty Sessions tracker artifact.
# Leave empty to skip.
ARTIFACT_URL=https://claude.ai/code/artifact/7be183d7-beeb-4c8b-bd9a-1c308d7498c9
