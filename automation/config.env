# Sixty Sessions — daily runner configuration.
# Plain KEY=value. No shell expansion, no quotes needed.

# --- what to run -------------------------------------------------------
REPO_DIR=/home/alberto/Documentos/Personal/Financial_manager
ROADMAP_FILE=ROADMAP.md

# Time the timer fires, local time (Europe/Madrid). Used by install.sh.
RUN_TIME=19:30

# --- how the agent runs ------------------------------------------------
MODEL=opus
# Hard wall-clock limit for one step, in seconds. The step is abandoned
# after this and the day is marked failed rather than left half-done.
STEP_TIMEOUT=3600
# Anything not in this list is DENIED automatically instead of prompting,
# so an unattended run can never hang waiting for input.
ALLOWED_TOOLS=Read,Write,Edit,Glob,Grep,NotebookEdit,TodoWrite,WebFetch,WebSearch,Bash

# --- git ---------------------------------------------------------------
BASE_BRANCH=main
# branch = one branch per day, pushed for review (default, reversible)
# main   = commit straight onto BASE_BRANCH (no review gate)
BRANCH_MODE=branch
PUSH=1
# With BRANCH_MODE=branch: merge the day's branch into BASE_BRANCH as soon as
# the step verifies, then push BASE_BRANCH. The day branch never reaches
# GitHub, so there is no pull request to accept. A day that FAILS is never
# merged - its partial work stays on its own branch for you to look at.
AUTO_MERGE=1
# Requires a working `gh auth status`. Pointless while AUTO_MERGE=1, since
# there is no remote branch left to open a PR from.
OPEN_PR=0

# --- reporting ---------------------------------------------------------
NOTIFY=1
# Optional: tick the day off in the Sixty Sessions tracker artifact.
# Leave empty to skip.
ARTIFACT_URL=https://claude.ai/code/artifact/7be183d7-beeb-4c8b-bd9a-1c308d7498c9
