[Unit]
Description=Sixty Sessions - implement one roadmap step
Documentation=file:%h/Documentos/Personal/Financial_manager/automation/README.md
# No network ordering here on purpose. network-online.target is a SYSTEM
# target and is invisible to the user manager - `systemctl --user list-units
# network-online.target` reports it not-found - so Wants=/After= on it were
# silently doing nothing. The wait lives in ExecStartPre below instead.

# Rate limiting belongs in [Unit], and BOTH halves must be set here: left to
# its 10-second default, StartLimitIntervalSec means a retry 30 minutes later
# is always outside the window, the counter resets, and StartLimitBurst never
# trips. Two hours covers the one retry below and nothing else.
StartLimitIntervalSec=7200
StartLimitBurst=2

[Service]
Type=oneshot
WorkingDirectory=__REPO_DIR__

# Wait up to five minutes for name resolution to come back after a boot or a
# resume, then start regardless. Deliberately always exits 0: if the network
# really is down, the runner is the thing that should notice, because it is
# the thing that records the failed day and tells your desktop about it. An
# ExecStartPre that failed here would abort the run silently instead.
ExecStartPre=/bin/bash -c 'for i in $(seq 1 30); do getent hosts github.com >/dev/null 2>&1 && break; sleep 10; done; exit 0'

ExecStart=/usr/bin/python3 __REPO_DIR__/automation/roadmap_runner.py run

# `claude` and user-level tools live in ~/.local/bin, which a systemd
# user unit does not inherit.
Environment=PATH=%h/.local/bin:%h/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=%h
# So notify-send can reach the desktop session.
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus

# A step gets an hour by default (STEP_TIMEOUT); give the unit headroom
# on top for git, tests and the tracker sync.
TimeoutStartSec=5400

# One retry, half an hour later, for a transient network or API failure.
# A genuine step failure is recorded and not retried - it needs a human, and
# the runner's "already ran today" guard makes the retry exit quietly anyway.
Restart=on-failure
RestartSec=1800

# Modest hardening: this runs unattended and writes code.
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=default.target
